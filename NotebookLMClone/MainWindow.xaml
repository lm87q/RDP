<Window x:Class="NotebookLMClone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotebookLM Clone" Height="820" Width="1280"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Projects" FontSize="18" FontWeight="SemiBold" Margin="0 0 0 12" />
                    <Button x:Name="NewProjectButton" Content="New Project" Click="NewProjectButton_OnClick"
                            Background="{StaticResource PrimaryBrush}" Foreground="White" Padding="10"/>
                    <ListBox x:Name="ProjectsListBox" Margin="0 12 0 12" DisplayMemberPath="Name"
                             SelectionChanged="ProjectsListBox_OnSelectionChanged" />
                    <Separator />
                    <TextBlock Text="Files" FontSize="16" FontWeight="SemiBold" Margin="0 12 0 8" />
                    <Button x:Name="UploadFilesButton" Content="Upload Files" Click="UploadFilesButton_OnClick"
                            Background="{StaticResource PrimaryBrush}" Foreground="White" Padding="10"/>
                    <ListBox x:Name="FilesListBox" Margin="0 8 0 0" DisplayMemberPath="DisplayName" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Ask your knowledge base" FontSize="20" FontWeight="SemiBold" Margin="0 0 0 12" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 12">
                    <TextBox x:Name="QuestionTextBox" Width="680" Height="40" VerticalContentAlignment="Center"
                             FontSize="14" Margin="0 0 12 0"/>
                    <Button x:Name="AskButton" Content="Ask" Click="AskButton_OnClick"
                            Background="{StaticResource PrimaryBrush}" Foreground="White" Padding="16 10" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <RichTextBox x:Name="AnswerRichTextBox" IsReadOnly="True" Background="#F9FAFC"
                                 BorderThickness="0" Margin="0 0 0 12" />
                    <DataGrid x:Name="SourcesDataGrid" Grid.Row="1" Height="220" AutoGenerateColumns="False"
                              HeadersVisibility="Column" CanUserAddRows="False" Margin="0 0 0 0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceLabel}" Width="*" />
                            <DataGridTextColumn Header="Snippet" Binding="{Binding Snippet}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0 12 0 0">
                    <TextBlock Text="Conversation History" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 8" />
                    <ListBox x:Name="HistoryListBox" DisplayMemberPath="DisplayText" Height="180" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
